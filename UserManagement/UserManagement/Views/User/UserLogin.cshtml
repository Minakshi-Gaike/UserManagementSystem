@using UserManagement.DTOs
@model UserLoginDTO

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    // Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                background: #ffffff;
                overflow-x: hidden;
            }

            .login-section {
                height: 100vh;
            }

            .left-side {
                display: flex;
                justify-content: center;
                align-items: center;
            }

                .left-side img {
                    width: 85%;
                }

            .right-side {
                display: flex;
                justify-content: center;
                align-items: center;
            }

            .login-box {
                width: 420px;
            }

            .logo {
                text-align: center;
                margin-bottom: 30px;
            }

                .logo h1 {
                    color: royalblue;
                    font-size: 70px;
                    font-weight: bold;
                    margin-bottom: 0;
                }

                .logo h5 {
                    color: royalblue;
                    margin-top: -15px;
                }

            .form-control {
                height: 50px;
            }

            .btn-login {
                width: 150px;
                height: 50px;
                font-size: 22px;
            }

            .footer {
                position: fixed;
                bottom: 0;
                width: 100%;
                background: #0d6efd;
                color: white;
                padding: 15px;
            }

                .footer a {
                    color: white;
                    text-decoration: none;
                }

            .error {
                color: red;
            }
    </style>

</head>

<body>

    <div class="container-fluid login-section">

        <div class="row vh-100">

            <!-- Left Image -->

            <div class="col-md-7 left-side">

                <img src="~/Images/Login.avif" class="img-fluid" />

            </div>

            <!-- Right Login -->

            <div class="col-md-5 right-side">

                <div class="login-box">

                    <div class="logo">

                        <h1>CIIT</h1>

                        <h5>Training Institute</h5>

                    </div>


                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()


                        <div class="mb-4">

                            <label>Email address</label>

                            @Html.TextBoxFor(x => x.EmailAddress,
                            new { @class = "form-control" })
                            <td><span style="color:red">@Html.ValidationMessageFor(e => e.EmailAddress)</span></td>


                        </div>

                        <div class="mb-4">

                            <label>Password</label>

                            @Html.PasswordFor(x => x.Password,
                            new { @class = "form-control" })
                            <td><span style="color:red">@Html.ValidationMessageFor(e => e.Password)</span></td>


                        </div>

                        <div class="d-flex justify-content-between mb-4">

                            <div>

                                <input type="checkbox" />

                                Remember me

                            </div>

                            <a href="#">Forgot password?</a>

                        </div>

                        <input type="submit"
                               value="Login"
                               class="btn btn-primary btn-login" />

                        <p class="error mt-2">@ViewBag.errormsg</p>

                        <div class="mt-4">

                            Don't have an account?

                            <a href="/User/UserRegister" class="text-danger fw-bold">
                                Register
                            </a>

                        </div>

                    }
                   

                </div>

            </div>

        </div>

    </div>

    <div class="footer">

        <div class="row text-center">

            <div class="col-md-4">

                Copyright ©2026

            </div>

            <div class="col-md-4">

                <a href="#">Admin Login</a>

            </div>

            <div class="col-md-4">

                <a href="#">User Login</a>

            </div>

        </div>

    </div>

</body>

</html>