@using UserManagement.DTOs
@model UserLoginDTO

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    .login-section {
        height: 100%;
    }

    .left-side,
    .right-side {
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .left-side img {
            width: 75%;
            max-height: 500px;
            object-fit: contain;
        }

    .login-box {
        width: 420px;
    }

    .logo {
        text-align: center;
        margin-bottom: 30px;
    }

        .logo h1 {
            color: #0d6efd;
            font-size: 70px;
            font-weight: bold;
            margin-bottom: 0;
        }

        .logo h5 {
            color: #0d6efd;
            margin-top: -12px;
            font-weight: 500;
        }

    label {
        font-weight: 500;
        margin-bottom: 6px;
    }

    .form-control {
        height: 50px;
        border-radius: 8px;
    }

    .btn-login {
        width: 170px;
        height: 50px;
        font-size: 22px;
        border-radius: 8px;
    }

    .error {
        color: red;
    }

    @@media (max-width:768px) {

        .left-side {
            display: none;
        }

        .login-box {
            width: 100%;
            padding: 20px;
        }
    }
</style>

<div class="container-fluid login-section">

    <div class="row align-items-center h-100">

        <!-- Left Image -->
        <div class="col-lg-7 left-side">
            <img src="~/Images/Login.avif" class="img-fluid" alt="Login Image" />
        </div>

        <!-- Login Form -->
        <div class="col-lg-5 right-side">

            <div class="login-box">

                <div class="logo">
                    <h1>CIIT</h1>
                    <h5>Training Institute</h5>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label>Email Address</label>
                        @Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control" })
                        <span class="text-danger">
                            @Html.ValidationMessageFor(m => m.EmailAddress)
                        </span>
                    </div>

                    <div class="mb-3">
                        <label>Password</label>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                        <span class="text-danger">
                            @Html.ValidationMessageFor(m => m.Password)
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="remember">
                            <label class="form-check-label" for="remember">
                                Remember me
                            </label>
                        </div>

                        <a href="#">Forgot Password?</a>

                    </div>

                    <input type="submit"
                           value="Login"
                           class="btn btn-primary btn-login mb-3" />

                    <div class="error">
                        @ViewBag.errormsg
                    </div>

                    <p class="mt-4">
                        Don't have an account?
                        <a asp-controller="User"
                           asp-action="UserRegister"
                           class="text-danger fw-bold text-decoration-none">
                            Register
                        </a>
                    </p>
                }

            </div>

        </div>

    </div>

</div>