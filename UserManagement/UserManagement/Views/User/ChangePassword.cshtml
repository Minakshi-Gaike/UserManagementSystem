
@model UserManagement.DTOs.ChangePasswordDTO


@{
    ViewData["Title"] = "ChangePassword";
    Layout = "~/Views/Shared/_ProfileLayout.cshtml";
}

<div class="row">

    @if (ViewBag.msg != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <strong>Success!</strong> @ViewBag.msg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Error Alert -->
    @if (ViewBag.errormsg != null)
    {
        <div id="dverror" class="alert alert-danger alert-dismissible fade show">
            <strong>Error!</strong> @ViewBag.errormsg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <script>
                setTimeout(function(){
                    document.getElementById("dverror").setAttribute("hidden","hidden");
                },3000);
        </script>
    }

    <div class="col-md-4">
        @using (Html.BeginForm())
        {
            @Html.HiddenFor(e => e.UserID)
            <div class="card">
                <div class="card-header">
                    <h5>Change Password</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <lable>Email Address</lable>
                        @Html.TextBoxFor(e => e.EmailAddress, new { @class = "form-control", @readOnly = "readonly" })

                    </div>

                    <div class="mb-3">
                        <lable>Current Password</lable>
                        @Html.PasswordFor(e => e.CurrentPassword, new { @class = "form-control" })

                    </div>

                    <div class="mb-3">
                        <lable>New Password</lable>
                        @Html.PasswordFor(e => e.NewPassword, new { @class = "form-control" })

                    </div>

                    <div class="mb-3">
                        <lable>Confirm Password</lable>
                        @Html.PasswordFor(e => e.ConfirmPassword, new { @class = "form-control" })

                    </div>

                </div>
                <div class="card-footer">
                    <input type="submit" value="Change Password" class="btn btn-primary" />

                </div>
            </div>
        }

    </div>

</div>