@using UserManagement.DTOs

@model UserRegisterDTO

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    List<TblUser> Roles = ViewData["user"] as List<TblUser>;
}

<div class="container mt-5">
    <div class="row justify-content-center">

        <div class="col-lg-8">

            @using (Html.BeginForm("UserRegister", "User", FormMethod.Post,
                        new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <div class="card shadow border-0">

                    <div class="card-header bg-primary text-white">
                        <h3 class="mb-0 text-center">
                            User Registration
                        </h3>
                    </div>

                    <div class="card-body">

                        <div class="row">

                            <!-- User Name -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">User Name</label>
                                @Html.TextBoxFor(m => m.UserName,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Enter User Name"
                                })
                                <td><span style="color:red">@Html.ValidationMessageFor(e=>e.UserName)</span></td>
                            </div>

                            <!-- Gender -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold d-block">
                                    Gender
                                </label>

                                <div class="form-check form-check-inline">
                                    @Html.RadioButtonFor(m => m.Gender, "Male",
                                    new { @class = "form-check-input", id = "Male" })

                                    <label class="form-check-label" for="Male">
                                        Male
                                    </label>
                                </div>

                                <div class="form-check form-check-inline">
                                    @Html.RadioButtonFor(m => m.Gender, "Female",
                                    new { @class = "form-check-input", id = "Female" })

                                    <label class="form-check-label" for="Female">
                                        Female
                                    </label>
                                </div>
                                <td><span style="color:red">@Html.ValidationMessageFor(e=>e.Gender)</span></td>
                            </div>

                            <!-- Birth Date -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Birth Date</label>

                                @Html.TextBoxFor(m => m.BirthDate,
                                new
                                {
                                    @type = "date",
                                    @class = "form-control"
                                })
                                <td><span style="color:red">@Html.ValidationMessageFor(e=>e.BirthDate)</span></td>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Email Address</label>

                                @Html.TextBoxFor(m => m.EmailAddress,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Enter Email"
                                })
                                <td><span style="color:red">@Html.ValidationMessageFor(e=>e.EmailAddress)</span></td>
                            </div>
                            @* <!-- Password -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Password</label>

                                @Html.PasswordFor(m => m.Password,
                                new
                                
                                {
                                    @class = "form-control",
                                    placeholder = "Enter Password"
                                })
                            </div> *@
                            <!-- Registration Date -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Registration Date</label>

                                @Html.TextBoxFor(m => m.RegistrationDate,
                                new

                                {
                                    @type = "date",
                                    @class="form-control"
                                })
                            </div>

                            <!-- Mobile -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Mobile Number</label>

                                @Html.TextBoxFor(m => m.MobileNumber,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Enter Mobile Number"
                                })
                                <td><span style="color:red">@Html.ValidationMessageFor(e=>e.MobileNumber)</span></td>
                            </div>

                            <!-- Address -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Local Address</label>

                                @Html.TextAreaFor(m => m.LocalAddress,
                                new
                                {
                                    @class = "form-control",
                                    rows = "2",
                                    placeholder = "Enter Address"
                                })
                            </div>

                            <!-- Role -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Role</label>

                                @Html.DropDownListFor(m => m.RoleId,
                                    ViewBag.Roles as SelectList,
                                    "-- Select Role --",
                                    new { @class = "form-select" })
                            </div>

                            <!-- Profile Photo -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">
                                    Profile Photo
                                </label>

                                <input type="file"
                                       name="ProfilePhoto"
                                       class="form-control" />
                            </div>
                            <td><span style="color:red">@Html.ValidationMessageFor(e=>e.ProfilePhoto)</span></td>

                        </div>

                    </div>

                    <div class="card-footer text-center">

                        <button type="submit" class="btn btn-success px-4">
                            Register
                        </button>

                        <button type="reset" class="btn btn-secondary px-4">
                            Clear
                        </button>

                    </div>

                </div>
            }
            @* Already Registered ?<a href="/User/UserLogin">Login Here</a> *@
            <div class="text-center mt-3">
                <span>Already Registered? </span>
                <a href="/User/UserLogin" class="text-decoration-none fw-bold">
                    Login Here
                </a>
            </div>


        </div>


    </div>
</div>
<h2 style="color:green">@ViewBag.msg</h2>

