@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@inject IHttpContextAccessor Accessor

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>User Management - @ViewData["Title"].ToString()</title>
    <Link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <div>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container-fluid">
                <a href="#" class="navbar-brand">CIIT</a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarCollapse2">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarCollapse2">
                    <div class="navbar-nav ms-auto">
                        @if (Accessor.HttpContext.Session.GetString("user") != null)
                        {
                            string user = Accessor.HttpContext.Session.GetString("User");
                            TblUser u = (TblUser)JsonConvert.DeserializeObject<TblUser>(user);
                            <a class="nav-item nav-link">Hi @u.UserName </a>
                            <a href="/Account/Logout" class="nav-item nav-link">Log Out</a>

                        }
                        else
                        {
                            <a href="/User/UserLogin" class="nav-item nav-link">Login </a>
                            <a href="/User/UserRegister" class="nav-item nav-link">Register</a>

                        }
                    </div>
                </div>
            </div>
        </nav>

    </div>
    <div class="container-fluid">
        @RenderBody()
    </div>




</body>
</html>