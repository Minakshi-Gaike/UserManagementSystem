@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@inject IHttpContextAccessor Accessor


@{
     ViewData["Title"] = "_ProfileLayout";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    string user = Accessor.HttpContext.Session.GetString("User");
    TblUser u = (TblUser)JsonConvert.DeserializeObject<TblUser>(user);
}

<div class="mt-2">
    <div class="row">
        <div class="col-md-2">
            <div class="text-center">
                <img height="100" width="100" src="~/Users/@u.ProfilePhoto" class="img-thumbnail" />
            </div>
            <h6 style="text-align:center">@u.UserName</h6>
            <ul class="list-group">
                <li class="list-group-item p-2">

                    <a class="nav-link" href=/>Dashboard</a>
                    <a class="nav-link" href="/User/UserProfile">Profile</a>
                    <a class="nav-link" href="/User/ChangePassword">Change Password</a>
                    <a class="nav-link" href="/User/ChangePhoto">Change Photo</a>


                </li>

            </ul>

        </div>
        <div class="col-md-10">
            @RenderBody()

        </div>

    </div>

</div>