@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using UserManagement.Models

@inject IHttpContextAccessor Accessor

@{
    ViewData["Title"] = "_ProfileLayout";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    string user = Accessor.HttpContext.Session.GetString("User");

    TblUser u = null;

    if (!string.IsNullOrEmpty(user))
    {
        u = JsonConvert.DeserializeObject<TblUser>(user);
    }
}

<div class="mt-2">

    <div class="row">

        <div class="col-md-2">

            <div class="text-center">

                @if (u != null && !string.IsNullOrEmpty(u.ProfilePhoto))
                {
                    <img height="100"
                         width="100"
                         src="~/ProfilePhoto/@u.ProfilePhoto"
                         class="img-thumbnail" />
                }
                else
                {
                    <p>No Profile Photo</p>
                }

            </div>

            @if (u != null)
            {
                <h6 style="text-align:center">
                    @u.UserName
                </h6>
            }

            <ul class="list-group p-2">

                <li class="list-group-item">
                    <a class="nav-link"
                       href="/User/UserProfile">
                        Profile
                    </a>
                </li>

                <li class="list-group-item">
                    <a class="nav-link"
                       href="/User/ChangePassword">
                        Change Password
                    </a>
                </li>

                <li class="list-group-item">
                    <a class="nav-link"
                       href="/User/ChangePhoto">
                        Change Profile Photo
                    </a>
                </li>

            </ul>

        </div>

        <div class="col-md-10">

            @RenderBody()

        </div>

    </div>

</div>